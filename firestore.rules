rules_version = '2';

// 開發版規則：登入的人可以讀公開資料，前端完全不能寫（所有寫入都走 Cloud Functions）
// 沒有寫出來的路徑一律擋掉，例如：
//   players/{pid}/private/**              密碼雜湊
//   seasons/{sid}/accounts/{pid}/ledger/** 流水帳（只有主辦透過伺服器查）
//   seasons/{sid}/interestRuns/**          計息紀錄
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    match /config/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    match /players/{pid} {
      allow read: if signedIn();
      allow write: if false;

      // 自己領過哪些信
      match /mailClaims/{mid} {
        allow read: if signedIn() && request.auth.token.pid == pid;
        allow write: if false;
      }
    }

    // 信箱：全部人都讀得到信件列表，領取與否由伺服器判斷
    match /mail/{mid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 意見箱：只開放本人與管理員讀取，所有寫入都走 Cloud Functions
    match /feedback/{fid} {
      allow read: if signedIn() &&
        (request.auth.token.pid == resource.data.pid || request.auth.token.role == 'admin');
      allow write: if false;
    }

    match /vanity/{num} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 星界交易所：行情公開給已登入玩家，交易與管理操作只走 Cloud Functions
    match /market/{doc} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 德州：牌桌公開；每個人只讀得到自己的底牌；整副牌（secret）完全不開放
    match /games/poker/tables/{tid} {
      allow read: if signedIn();
      allow write: if false;

      match /live/{doc} {
        allow read: if signedIn();
        allow write: if false;
      }

      match /holes/{pid} {
        allow read: if signedIn() && request.auth.token.pid == pid;
        allow write: if false;
      }
    }

    // 21 點：牌桌公開，牌靴（secret）不開放
    match /games/bj/tables/{tid} {
      allow read: if signedIn();
      allow write: if false;
    }

    // 大老二：牌桌公開；每個人只讀得到自己的手牌；secret 完全不開放
    match /games/big2/tables/{tid} {
      allow read: if signedIn();
      allow write: if false;

      match /hands/{pid} {
        allow read: if signedIn() && request.auth.token.pid == pid;
        allow write: if false;
      }
    }

    match /seasons/{sid} {
      allow read: if signedIn();
      allow write: if false;

      match /accounts/{pid} {
        allow read: if signedIn();
        allow write: if false;
      }
    }
  }
}
